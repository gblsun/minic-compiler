func main
  soma = 0
  i = 0
L_test:
  t1 = i < 6
  ifFalse t1 goto L_end
  t2 = i % 2
  t3 = t2 == 0
  ifFalse t3 goto L_end_if
  goto L_step
L_end_if:
  j = 0
L_test2:
  ifFalse true goto L_end2
  t4 = j >= i
  ifFalse t4 goto L_end_if2
  goto L_end2
L_end_if2:
  t5 = soma + j
  soma = t5
  t6 = j + 1
  j = t6
