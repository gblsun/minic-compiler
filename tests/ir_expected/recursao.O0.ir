func fib(n)
  t1 = n < 2
  ifFalse t1 goto L_end_if
  return n
L_end_if:
  t2 = n - 1
  param t2
  t3 = call fib, 1
  t4 = n - 2
  param t4
  t5 = call fib, 1
  t6 = t3 + t5
  return t6
endfunc
func main
  i = 0
L_test:
  t1 = i < 10
  ifFalse t1 goto L_end
  param i
  t2 = call fib, 1
  print t2
  t3 = i + 1
  i = t3
  goto L_test
L_end:
  return 0
endfunc
